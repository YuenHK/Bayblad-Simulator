{
  "name": "@steam-top/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/client.ts",
    "./queries": "./src/queries.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config ../../drizzle.config.ts",
    "db:check": "drizzle-kit check --config ../../drizzle.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "drizzle-kit": "0.31.10",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
