# Required in production: api, csv, api-csv-fallback, or guest-only-explicit
ICLASS_MODE=guest-only-explicit
ICLASS_API_URL=
ICLASS_API_BEARER_TOKEN=
ICLASS_API_TIMEOUT_MS=3000
ICLASS_API_MAX_ATTEMPTS=2
ICLASS_DEVICE_MAP_CSV_PATH=
# JSON object of key id to base64url-encoded 32+ byte secret. Never commit real keys.
WEBCLIP_SIGNING_KEYS_JSON=
WEBCLIP_ACTIVE_KEY_ID=
WEBCLIP_EXCHANGE_KEY=
WEBCLIP_AUDIENCE=steam-top

# Required in production. Inject the school deployment credentials as secrets;
# do not commit their values. Password changes are not forced by the application.
ADMIN_USERNAME=
ADMIN_INITIAL_PASSWORD=
ADMIN_CSRF_SECRET=
ADMIN_CSRF_KEY_ID=
PUBLIC_ORIGIN=
