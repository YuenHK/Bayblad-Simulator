# Copy this file to .env on the deployment host. Never commit .env.
# PUBLIC_HOST contains no scheme or path.
PUBLIC_HOST=
PUBLIC_ORIGIN=

POSTGRES_DB=steam_top
POSTGRES_USER=steam_top
POSTGRES_PASSWORD=
DATABASE_URL=
POSTGRES_TLS_CERT=
POSTGRES_TLS_KEY=
DATABASE_TLS=require

# Use independent random values of at least 32 characters.
COOKIE_SIGNING_KEY=
ADMIN_CSRF_SECRET=
WEBCLIP_SIGNING_KEY=
WEBCLIP_EXCHANGE_KEY=
ANALYTICS_CURSOR_SECRET=

# 校方指定的預設教師帳號為 admin，初始密碼為 fwft2026；系統不強制更改。
# 正式 .env 才填寫密碼，切勿把密碼提交 Git。
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=
ADMIN_CSRF_KEY_ID=primary

# Must equal restore_control.deployment_environment.restore_target_id.
DELETION_SOURCE_INSTANCE_ID=
DELETION_LEDGER_FILE=/var/lib/steam-top/deletion-ledger.log

# Required in production: api, csv, api-csv-fallback, or guest-only-explicit.
ICLASS_MODE=guest-only-explicit
ICLASS_API_URL=
ICLASS_API_BEARER_TOKEN=
ICLASS_API_TIMEOUT_MS=3000
ICLASS_API_MAX_ATTEMPTS=2
ICLASS_DEVICE_MAP_CSV_PATH=
WEBCLIP_AUDIENCE=steam-top
