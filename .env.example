# Copy this file to .env on the deployment host. Never commit .env.
PUBLIC_ORIGIN=

# Required immutable base image references. Supply verified digests; do not guess.
NODE_IMAGE=
POSTGRES_IMAGE=
CADDY_IMAGE=
DEPLOYMENT_VERSION=

POSTGRES_DB=steam_top
POSTGRES_USER=steam_top
POSTGRES_PASSWORD=
DATABASE_URL=
POSTGRES_TLS_CERT_PATH=
POSTGRES_TLS_KEY_PATH=
DATABASE_TLS=require

# Use independent canonical base64url values that decode to at least 32 bytes.
COOKIE_SIGNING_KEY=
ADMIN_CSRF_SECRET=
WEBCLIP_SIGNING_KEY=
WEBCLIP_EXCHANGE_KEY=
ANALYTICS_CURSOR_SECRET=

# 校方指定的預設教師帳號為 admin，初始密碼為 fwft2026；系統不強制更改。
# 正式 .env 才填寫密碼，切勿把密碼提交 Git。
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=
ADMIN_CSRF_KEY_ID=primary

# Migration writes the protected restore target ID to an internal volume.
DELETION_LEDGER_FILE=/var/lib/steam-top/deletion-ledger.log

# Required in production: api, csv, api-csv-fallback, or guest-only-explicit.
ICLASS_MODE=guest-only-explicit
ICLASS_API_URL=
ICLASS_API_BEARER_TOKEN=
ICLASS_API_TIMEOUT_MS=3000
ICLASS_API_MAX_ATTEMPTS=2
# Optional host path; the committed header-only safe map is used when blank.
ICLASS_DEVICE_MAP_PATH=
WEBCLIP_AUDIENCE=steam-top
